# Copy to .env and fill in real values. Never commit .env.

# Reddit "script" app (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
# Descriptive UA per Reddit API rules: <platform>:<app id>:<version> (by /u/<username>)
REDDIT_USER_AGENT=script:ideation-pipeline:0.1 (by /u/your_reddit_username)

# Stack Exchange app key (https://stackapps.com/apps/oauth/register).
# Optional, but raises the quota from 300 to 10,000 requests/day.
STACKEXCHANGE_KEY=

# Salt for hashing author names into author_hash (never store raw usernames)
AUTHOR_HASH_SALT=change_me_to_a_long_random_string

# Other services (later phases)
ANTHROPIC_API_KEY=
APIFY_TOKEN=
# Matches the local container in docker-compose.yml
DATABASE_URL=postgresql://ideation:ideation@localhost:5432/ideation
